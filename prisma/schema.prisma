generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  password                 String
  userType                 UserType             @default(USER)
  status                   UserStatus           @default(INACTIVE)
  isEmailVerified          Boolean              @default(false)
  emailVerificationToken   String?              @unique
  emailVerificationExpires DateTime?
  mfaEnabled               Boolean              @default(false)
  mfaMethod                MFAMethod?
  mfaSecret                String?
  backupCodes              String[]             @default([])
  resetPasswordToken       String?              @unique
  resetPasswordExpires     DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  lastLoginAt              DateTime?
  auditLogs                AuditLog[]
  loginHistory             LoginHistory[]
  organizations            OrganizationMember[]
  profile                  Profile?
  sessions                 Session[]

  @@index([email])
  @@index([status])
  @@index([userType])
  @@map("users")
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  firstName      String?
  lastName       String?
  phone          String?
  avatar         String?
  birthDate      DateTime?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  companyName    String?
  companyVat     String?
  companyAddress String?
  jobTitle       String?
  department     String?
  skills         String[]  @default([])
  certifications String[]  @default([])
  specialization String?
  licenseNumber  String?
  licenseExpiry  DateTime?
  licenseType    String?
  language       String    @default("pt")
  timezone       String    @default("Europe/Lisbon")
  notifications  Boolean   @default(true)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model Session {
  id           String       @id @default(uuid())
  userId       String
  token        String       @unique
  refreshToken String?      @unique
  ipAddress    String
  userAgent    String?
  device       String?
  browser      String?
  os           String?
  country      String?
  city         String?
  latitude     Float?
  longitude    Float?
  onlineStatus OnlineStatus @default(ONLINE)
  isActive     Boolean      @default(true)
  lastActivity DateTime     @default(now())
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("sessions")
}

model LoginHistory {
  id        String      @id @default(uuid())
  userId    String
  result    LoginResult
  reason    String?
  ipAddress String
  userAgent String?
  device    String?
  browser   String?
  os        String?
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  mfaUsed   Boolean     @default(false)
  mfaMethod MFAMethod?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([result])
  @@map("login_history")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  description String
  changes     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Organization {
  id                    String                      @id @default(uuid())
  name                  String
  slug                  String                      @unique
  description           String?
  settings              Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?
  email                 String
  isActive              Boolean                     @default(true)
  logoUrl               String?
  metadata              Json?
  phone                 String?
  type                  OrganizationType            @default(MARKETPLACE)
  website               String?
  articleWarehouseCache ArticleWarehouseSyncCache[]
  clientConnections     ClientProviderConnection[]  @relation("ClientConnections")
  providerConnections   ClientProviderConnection[]  @relation("ProviderConnections")
  dataSourceConfig      DataSourceConfig?
  notificationSettings  NotificationSettings?
  members               OrganizationMember[]
  providerConfig        ProviderConfig?
  syncArticles          SyncArticle[]
  syncConfigurations    SyncConfiguration[]
  syncErrorLogs         SyncErrorLog[]
  syncExecutionLogs     SyncExecutionLog[]
  syncJobs              SyncJob[]
  syncedArticles        SyncedArticle[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
  @@map("organizations")
}

model OrganizationMember {
  id               String           @id @default(uuid())
  organizationId   String
  userId           String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  inviteAcceptedAt DateTime?
  inviteExpires    DateTime?
  inviteToken      String?          @unique
  invitedBy        String?
  isActive         Boolean          @default(true)
  joinedAt         DateTime         @default(now())
  role             OrganizationRole @default(MEMBER)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([inviteToken])
  @@map("organization_members")
}

model ProviderConfig {
  id                 String              @id @default(uuid())
  organizationId     String              @unique
  apiUrl             String
  apiKey             String?
  apiSecret          String?
  clientId           String?
  clientSecret       String?
  authType           String?
  authEndpoint       String?
  tokenEndpoint      String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  webhookUrl         String?
  webhookSecret      String?
  webhookEvents      String[]            @default([])
  rateLimit          Int?                @default(60)
  rateLimitWindow    Int?                @default(60)
  maxRetries         Int?                @default(3)
  retryDelay         Int?                @default(1000)
  fieldMappings      Json?
  settings           Json?
  metadata           Json?
  isActive           Boolean             @default(true)
  lastSyncAt         DateTime?
  lastErrorAt        DateTime?
  lastError          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncArticles       SyncArticle[]
  syncConfigurations SyncConfiguration[]
  syncErrorLogs      SyncErrorLog[]
  syncExecutionLogs  SyncExecutionLog[]
  syncJobs           SyncJob[]
  syncedArticles     SyncedArticle[]

  @@index([organizationId])
  @@index([isActive])
  @@map("provider_configs")
}

model ClientProviderConnection {
  id             String       @id @default(uuid())
  clientOrgId    String
  providerOrgId  String
  merchantId     String?
  storeId        String?
  sellerId       String?
  accountId      String?
  credentials    Json?
  settings       Json?
  syncSettings   Json?
  isActive       Boolean      @default(true)
  isVerified     Boolean      @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  syncFrequency  Int?         @default(3600)
  totalOrders    Int          @default(0)
  totalProducts  Int          @default(0)
  totalRevenue   Float        @default(0)
  connectedAt    DateTime     @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clientOrg      Organization @relation("ClientConnections", fields: [clientOrgId], references: [id], onDelete: Cascade)
  providerOrg    Organization @relation("ProviderConnections", fields: [providerOrgId], references: [id], onDelete: Cascade)

  @@unique([clientOrgId, providerOrgId])
  @@index([clientOrgId])
  @@index([providerOrgId])
  @@index([isActive])
  @@map("client_provider_connections")
}

model DataSourceConfig {
  id                   String         @id @default(uuid())
  organizationId       String         @unique
  sourceType           DataSourceType @default(SQL_SERVER)
  sqlHost              String?
  sqlInstance          String?
  sqlPort              Int?
  sqlDatabase          String?
  sqlUser              String?
  sqlPassword          String?
  connectionTimeout    Int?           @default(15000)
  requestTimeout       Int?           @default(30000)
  poolMax              Int?           @default(10)
  poolMin              Int?           @default(0)
  productView          String?
  stockView            String?
  customerView         String?
  orderView            String?
  fieldMappings        Json?
  settings             Json?
  isActive             Boolean        @default(true)
  lastTestAt           DateTime?
  lastTestStatus       String?
  lastTestError        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  discountGroupView    String?
  discountSubGroupView String?
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
  @@map("data_source_configs")
}

model Customer {
  id          String    @id @default(uuid())
  companyName String
  taxId       String    @unique
  email       String
  phone       String?
  address     String?
  city        String?
  country     String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([email])
  @@index([taxId])
  @@map("customers")
}

model Integration {
  id        String    @id @default(uuid())
  name      String
  type      String
  config    Json
  apiKey    String?
  isActive  Boolean   @default(true)
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("integrations")
}

model SyncArticle {
  id                       String         @id @default(uuid())
  organizationId           String
  providerConfigId         String
  sourceArticleId          String?
  brandId                  String
  articleDiscountGroupCode String
  partNumber               String
  discountSubGroupCode     String
  internalPartNumber       String
  categoryCode             String
  attributeId              String?
  active                   Boolean        @default(true)
  availability             Boolean        @default(true)
  service                  Boolean        @default(false)
  sort                     Int            @default(0)
  picture                  String?
  articleName              String
  articleDescription       String
  daysAsNew                Int            @default(0)
  tag                      String?
  reservedForFutureUse     String?
  status                   SyncStatus     @default(PENDING)
  errorMessage             String?
  errorDetails             Json?
  attempts                 Int            @default(0)
  lastAttemptAt            DateTime?
  sentAt                   DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  organization             Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig           ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([providerConfigId])
  @@index([status])
  @@index([brandId])
  @@index([partNumber])
  @@map("sync_articles")
}

model SyncedArticle {
  id               String         @id @default(uuid())
  organizationId   String
  providerConfigId String
  brandId          Int
  partNumber       String
  syncedAt         DateTime       @default(now())
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerConfigId, brandId, partNumber], name: "synced_articles_unique")
  @@index([organizationId, providerConfigId])
  @@index([brandId, partNumber])
  @@map("synced_articles")
}

model SyncJob {
  id                     String         @id @default(uuid())
  organizationId         String
  providerConfigId       String
  type                   SyncJobType
  status                 SyncJobStatus  @default(PENDING)
  totalRecords           Int            @default(0)
  processedRecords       Int            @default(0)
  successRecords         Int            @default(0)
  errorRecords           Int            @default(0)
  batchSize              Int            @default(1000)
  currentBatch           Int            @default(0)
  filters                Json?
  progress               Float          @default(0)
  estimatedTimeRemaining Int?
  errorMessage           String?
  errorDetails           Json?
  retryCount             Int            @default(0)
  maxRetries             Int            @default(3)
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  errorLogs              SyncErrorLog[]
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig         ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([providerConfigId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("sync_jobs")
}

model SyncErrorLog {
  id               String         @id @default(uuid())
  organizationId   String
  providerConfigId String
  syncJobId        String?
  operation        String
  entityType       String
  errorMessage     String
  errorStack       String?
  errorCode        String?
  context          Json
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  syncJob          SyncJob?       @relation(fields: [syncJobId], references: [id])

  @@index([organizationId])
  @@index([providerConfigId])
  @@index([syncJobId])
  @@index([operation])
  @@index([entityType])
  @@index([createdAt])
  @@map("sync_error_logs")
}

model SyncConfiguration {
  id               String         @id @default(uuid())
  organizationId   String
  providerConfigId String
  syncType         SyncType
  enabled          Boolean        @default(true)
  intervalSeconds  Int            @default(300)
  lastSyncAt       DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  options          Json?          @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerConfigId, syncType])
  @@index([organizationId])
  @@index([providerConfigId])
  @@index([enabled])
  @@index([lastSyncAt])
  @@map("sync_configurations")
}

model SyncExecutionLog {
  id                  String              @id @default(uuid())
  syncConfigurationId String?
  organizationId      String
  providerConfigId    String
  syncType            SyncType
  status              SyncExecutionStatus
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  duration            Int?
  totalFetched        Int?                @default(0)
  totalProcessed      Int?                @default(0)
  totalSucceeded      Int?                @default(0)
  totalFailed         Int?                @default(0)
  totalSkipped        Int?                @default(0)
  errorMessage        String?
  errorStack          String?
  metadata            Json?               @default("{}")
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig      ProviderConfig      @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([syncConfigurationId])
  @@index([organizationId])
  @@index([providerConfigId])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
  @@map("sync_execution_logs")
}

model ArticleWarehouseSyncCache {
  id             String       @id @default(uuid())
  organizationId String
  brandId        String
  partNumber     String
  warehouseCode  String
  dataHash       String
  lastSyncedAt   DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, brandId, partNumber, warehouseCode])
  @@index([organizationId])
  @@index([lastSyncedAt])
  @@map("article_warehouse_sync_cache")
}

model ErrorNotificationLog {
  id                       String       @id @default(uuid())
  context                  ErrorContext
  method                   String
  errorMessage             String
  errorStack               String?
  internalPartNumber       String?
  orderNumber              String?
  articleDiscountGroupCode String?
  discountSubGroupCode     String?
  customerId               String?
  additionalInfo           Json?
  emailSent                Boolean      @default(false)
  emailSentAt              DateTime?
  emailRecipients          String[]     @default([])
  emailError               String?
  createdAt                DateTime     @default(now())

  @@index([context])
  @@index([method])
  @@index([createdAt])
  @@index([emailSent])
  @@index([internalPartNumber])
  @@index([orderNumber])
  @@index([customerId])
  @@map("error_notification_logs")
}

model NotificationSettings {
  id              String        @id @default(uuid())
  organizationId  String?       @unique
  notifyOnSuccess Boolean       @default(false)
  notifyOnError   Boolean       @default(true)
  notifyOnPartial Boolean       @default(true)
  emailRecipients String[]      @default([])
  syncTypes       String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum DataSourceType {
  SQL_SERVER
  MYSQL
  POSTGRESQL
  ORACLE
  REST_API
  GRAPHQL
  FILE_STORAGE
}

enum UserType {
  ADMIN
  DEV
  USER
  PARCERIA
  CLIENTE
  LICENCAS
  TECNICO
  AUDITORIA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OnlineStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum MFAMethod {
  EMAIL
  SMS
  TOTP
  BACKUP_CODES
}

enum OrganizationType {
  MARKETPLACE
  PROVIDER
  PARTNER
  CLIENT
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum LoginResult {
  SUCCESS
  FAILED
  BLOCKED
  MFA_REQUIRED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  MFA_ENABLE
  MFA_DISABLE
  ACCOUNT_SUSPEND
  ACCOUNT_ACTIVATE
  PERMISSION_CHANGE
}

enum SyncStatus {
  PENDING
  VALIDATED
  SENT
  ERROR
  REJECTED
  SKIPPED
}

enum SyncJobType {
  ARTICLES
  ARTICLE_WAREHOUSE
  CUSTOMERS
  CUSTOMER_DISCOUNT_GROUPS
  CUSTOMER_WAREHOUSES
  DISCOUNT_GROUPS
  DISCOUNT_SUBGROUPS
  ORDERS
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncType {
  DISCOUNT_GROUPS
  DISCOUNT_SUBGROUPS
  ARTICLES
  ARTICLE_WAREHOUSE
  CUSTOMERS
  CUSTOMER_DISCOUNT_GROUPS
  CUSTOMER_WAREHOUSES
  ORDERS
  ORDER_FETCH
}

enum SyncExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ErrorContext {
  articles
  warehouse
  orders
  discountGroup
  discountSubGroup
  customers
  customerDiscountGroup
  customerWarehouse
}
